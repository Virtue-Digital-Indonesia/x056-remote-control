# x056-remote-control configuration. Copy to .env and edit.
#   cp .env.example .env
# .env is gitignored — never commit it.

# ---- REQUIRED ----

# Fallback access token for the panel (passkeys are the primary login; this is
# the bootstrap + fallback). Generate a strong one:
#   openssl rand -hex 32
X056_TOKEN=

# WebAuthn/passkey relying-party id — the public hostname you load the panel at
# (behind your TLS-terminating reverse proxy). Comma-separated for multiple.
# localhost is always allowed for local dev.
X056_RP_ID=x056.example.com

# ---- PATHS (host paths; mounted into the container at the same path) ----

# Directory of repos the panel can open as projects.
X056_WORKSPACE_ROOT=/home/you/dev

# The two Claude account config dirs — each is a separate `claude /login`
# (scripts/setup.sh creates + logs these in for you). You can also add MORE
# accounts later from the panel (account chip → “+ Add account”), which stores
# them in the state volume — no env change needed.
X056_ACCOUNT_A_DIR=/home/you/.claude-x056-a
X056_ACCOUNT_B_DIR=/home/you/.claude-x056-b

# Optional: bootstrap MORE than two accounts at init time — a comma-separated
# list of config dirs (named a, b, c, …). Overrides the A/B pair above when set.
# Leave blank to use the A/B dirs; add further accounts from the panel anytime.
# X056_ACCOUNT_DIRS=/home/you/.claude-x056-a,/home/you/.claude-x056-b,/home/you/.claude-x056-c

# Panel HTML (bind-mount live-served). Point at this repo's checkout.
X056_PANEL_PATH=/home/you/dev/x056-remote-control/server/public/panel.html

# ---- OPTIONAL ----

# Your interactive `claude` sessions dir (read-only) so the panel can import +
# resume existing conversations. Defaults to ~/.claude/projects.
X056_INTERACTIVE_PROJECTS=/home/you/.claude/projects

# Host port the panel is served on (loopback only; nginx proxies to it).
# Only change this for a SECOND instance on the same host -- the container
# always listens on 4056 internally.
X056_PORT=4056

# ── REQUIRED per instance ────────────────────────────────────────────────
# These used to default to the author's own paths. That was a trap for a
# SECOND instance on the same host: forget one and it silently mounts the
# FIRST instance's data. Compose now refuses to start rather than default.
#
#  * WORKSPACE_ROOT — a repo tree that contains an instance's own .env also
#    contains its X056_TOKEN, and both containers run as uid 1001, so 0600
#    does not help. One `cat` = the other instance's whole API.
#  * ACCOUNT_*_DIR — every account dir's projects/ is symlinked into ONE
#    shared tree, so mounting another instance's hands over every
#    conversation and subagent transcript it has, writable.
#  * INTERACTIVE_PROJECTS — a user's personal ~/.claude transcripts.
X056_WORKSPACE_ROOT=/home/you/workspace
X056_ACCOUNT_A_DIR=/home/you/.claude-x056-a
X056_ACCOUNT_B_DIR=/home/you/.claude-x056-b
X056_INTERACTIVE_PROJECTS=/home/you/.claude/projects
# Point at THIS checkout for a live-served panel, or at the copy baked into
# the image (/app/server/public/panel.html) if the checkout is not mounted.
X056_PANEL_PATH=/home/you/workspace/x056-remote-control/server/public/panel.html
