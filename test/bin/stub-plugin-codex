#!/usr/bin/env node
// Stub `codex` for PluginManager tests. Exercises `codex plugin ...` only.
// - Appends every invocation (argv + CODEX_HOME) to $STUB_LOG (if set).
// - `plugin list --json`             -> {"installed": <configDir>/plugins.json or []}
// - `plugin marketplace list --json` -> {"marketplaces": <configDir>/marketplaces.json or []}
// - any mutation                     -> errors + exit 1 if <configDir>/FAIL exists,
//                                       else prints codex's real phrasing and exit 0.
import { appendFileSync, existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
const argv = process.argv.slice(2);
const cfg = process.env.CODEX_HOME || '';
if (process.env.STUB_LOG) appendFileSync(process.env.STUB_LOG, JSON.stringify({ argv, cfg }) + '\n');
function readJson(name) { try { return readFileSync(join(cfg, name), 'utf8'); } catch { return null; } }
const sub = argv[1];
if (sub === 'list' && argv.includes('--json')) {
  process.stdout.write(JSON.stringify({ installed: JSON.parse(readJson('plugins.json') || '[]'), available: [] }));
  process.exit(0);
}
if (sub === 'marketplace' && argv[2] === 'list' && argv.includes('--json')) {
  process.stdout.write(JSON.stringify({ marketplaces: JSON.parse(readJson('marketplaces.json') || '[]') }));
  process.exit(0);
}
if (existsSync(join(cfg, 'FAIL'))) { process.stderr.write('Error: simulated failure in ' + cfg + '\n'); process.exit(1); }
if (sub === 'add') process.stdout.write('Added plugin `' + argv[2] + '`.\n');
else if (sub === 'remove') process.stdout.write('Removed plugin `' + argv[2] + '`.\n');
else if (sub === 'marketplace') process.stdout.write((argv[2] === 'add' ? 'Added' : 'Removed') + ' marketplace `x`.\n');
else { process.stderr.write('error: unrecognized subcommand ' + sub + '\n'); process.exit(2); }
process.exit(0);
