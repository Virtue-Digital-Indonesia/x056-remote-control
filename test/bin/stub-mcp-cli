#!/usr/bin/env node
// Stub for BOTH `claude mcp …` and `codex mcp …`, chosen by $STUB_MCP_PROVIDER.
// Backed by a JSON file per config dir so add/remove/list actually round-trip,
// and it reproduces the behaviours the manager has to cope with:
//   - claude REFUSES to overwrite an existing name (exit 1)
//   - codex silently overwrites
//   - claude has no list command here (the manager reads .claude.json directly)
// Every invocation is appended to $STUB_LOG for argv assertions.
import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const argv = process.argv.slice(2);
const provider = process.env.STUB_MCP_PROVIDER || 'claude';
const cfg = (provider === 'codex' ? process.env.CODEX_HOME : process.env.CLAUDE_CONFIG_DIR) || '';
if (process.env.STUB_LOG) appendFileSync(process.env.STUB_LOG, JSON.stringify({ argv, cfg, provider }) + '\n');

mkdirSync(cfg, { recursive: true });
// claude's real store is .claude.json {mcpServers}; codex's is opaque here.
const file = join(cfg, provider === 'codex' ? 'codex-mcp.json' : '.claude.json');
const load = () => { try { return JSON.parse(readFileSync(file, 'utf8')); } catch { return {}; } };
const save = (o) => writeFileSync(file, JSON.stringify(o, null, 1));

const sub = argv[1]; // argv[0] === 'mcp'
const store = load();
store.mcpServers = store.mcpServers || {};

// The real codex reads config.toml, and the manager writes http servers WITH
// headers straight into it. Mirror that: merge the two table shapes it writes.
function tomlTables() {
  const file = join(cfg, 'config.toml');
  if (!existsSync(file)) return {};
  const out = {}; let cur = null;
  for (const raw of readFileSync(file, 'utf8').split('\n')) {
    const line = raw.trim();
    let m = line.match(/^\[mcp_servers\.([^\].]+)\]$/);
    if (m) { cur = { name: m[1], headers: false }; out[m[1]] = out[m[1]] || { type: 'http' }; continue; }
    m = line.match(/^\[mcp_servers\.([^\].]+)\.http_headers\]$/);
    if (m) { cur = { name: m[1], headers: true }; out[m[1]] = out[m[1]] || { type: 'http' }; out[m[1]].http_headers = out[m[1]].http_headers || {}; continue; }
    if (line.startsWith('[')) { cur = null; continue; }
    if (!cur || !line.includes('=')) continue;
    const eq = line.indexOf('='); const rawK = line.slice(0, eq).trim();
    const k = rawK.startsWith('"') ? JSON.parse(rawK) : rawK; const v = JSON.parse(line.slice(eq + 1).trim());
    if (cur.headers) out[cur.name].http_headers[k] = v; else if (k === 'url') out[cur.name].url = v;
  }
  return out;
}
function stripToml(name) {
  const file = join(cfg, 'config.toml');
  if (!existsSync(file)) return false;
  const esc = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const re = new RegExp('^\\[mcp_servers\\.' + esc + '(?:\\.[^\\]]*)?\\][^\\n]*\\n(?:(?!^\\[)[^\\n]*\\n?)*', 'gm');
  const before = readFileSync(file, 'utf8'); const after = before.replace(re, '');
  writeFileSync(file, after); return before !== after;
}
if (sub === 'list' && argv.includes('--json')) {
  // codex shape
  const merged = { ...store.mcpServers, ...(provider === 'codex' ? tomlTables() : {}) };
  const out = Object.entries(merged).map(([name, s]) => ({
    name,
    enabled: true,
    transport: s.type === 'http'
      ? { type: 'streamable_http', url: s.url, ...(s.http_headers ? { http_headers: s.http_headers } : {}) }
      : { type: 'stdio', command: s.command, args: s.args || [], env: s.env ?? null },
  }));
  process.stdout.write(JSON.stringify(out));
  process.exit(0);
}

if (sub === 'add-json') { // claude
  const name = argv[2];
  if (store.mcpServers[name]) { process.stdout.write(`MCP server ${name} already exists in user config\n`); process.exit(1); }
  store.mcpServers[name] = JSON.parse(argv[3]);
  save(store);
  process.stdout.write(`Added stdio MCP server ${name} to user config\n`);
  process.exit(0);
}

if (sub === 'add') { // codex: add <name> [--env K=V]... [--url U | -- cmd args...]
  const name = argv[2];
  const rest = argv.slice(3);
  const env = {};
  for (let i = 0; i < rest.length; i++) if (rest[i] === '--env') { const [k, ...v] = rest[++i].split('='); env[k] = v.join('='); }
  const urlAt = rest.indexOf('--url');
  const ddAt = rest.indexOf('--');
  store.mcpServers[name] = urlAt >= 0
    ? { type: 'http', url: rest[urlAt + 1] }
    : { type: 'stdio', command: rest[ddAt + 1], args: rest.slice(ddAt + 2), ...(Object.keys(env).length ? { env } : {}) };
  save(store); // codex OVERWRITES without complaint
  process.stdout.write(`Added global MCP server '${name}'.\n`);
  process.exit(0);
}

if (sub === 'remove') {
  const name = argv[2];
  const inToml = provider === 'codex' && stripToml(name); // the real CLI removes a hand-written table too
  if (!store.mcpServers[name] && !inToml) { process.stderr.write(`No MCP server named '${name}'\n`); process.exit(1); }
  delete store.mcpServers[name];
  save(store);
  process.stdout.write(`Removed global MCP server '${name}'.\n`);
  process.exit(0);
}

process.stderr.write(`stub: unsupported: ${argv.join(' ')}\n`);
process.exit(1);
